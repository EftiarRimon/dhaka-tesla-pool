DATABASE_URL=postgresql://tesla:tesla@db:5432/teslapool
JWT_SECRET=change-me
PORT=4000
# Copy this file to .env (git-ignored). Docker Compose reads it automatically.
# Every value below has the same default inside docker-compose.yml, so .env is optional for the Docker setup.

# --- Docker Compose ---
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=teslapool

# Signs login tokens. Replace it with a long random string anywhere outside your own machine.
JWT_SECRET=change-me

# --- Running api/web outside Docker (npm run dev) ---
# The API does not read .env files, so export these in your shell first.
# Compose builds DATABASE_URL itself from the POSTGRES_* values above and ignores it here.
#
# PowerShell example:  $env:DATABASE_URL = "postgresql://tesla:tesla@localhost:5432/teslapool"
#
# DATABASE_URL=postgresql://tesla:tesla@localhost:5432/teslapool
# PORT=4000
#
# Tests run against a separate database that must be named *_test (the test setup refuses anything else).
# TEST_DATABASE_URL=postgresql://tesla:tesla@localhost:5432/teslapool_test
#
# Where the web app proxies /api. It is read when Next.js builds, so rebuild the web image after changing it.
# API_URL=http://localhost:4000